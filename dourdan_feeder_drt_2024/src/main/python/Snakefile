import sys
import importlib.util


spec = importlib.util.spec_from_file_location("lib", "lib/__init__.py")
module_obj = importlib.util.module_from_spec(spec)
sys.modules["lib"] = module_obj
spec.loader.exec_module(module_obj)

from lib import PipelineConfig
from lib import to_absolute
from lib import memory_string_to_mb

config_object = PipelineConfig(config, workflow.basedir, workflow.cores)

def repo_url_to_id(repo_url):
    # SSH link example "git@github.com:eqasim-org/ile-de-france.git"
    # HTTPS link example https://github.com/eqasim-org/ile-de-france.git
    assert isinstance(repo_url, str)
    if not repo_url.startswith("git@github.com") and not repo_url.startswith("https://github.com"):
        raise Exception("Invalid repo_url")
    components = repo_url.split("/")
    repo_owner, repo_name = components[-2], components[-1]
    repo_name = repo_name.replace(".git", "")
    repo_owner = repo_owner.split(":")[-1]
    return "%s/%s" % (repo_owner, repo_name)

# General resources
temp_path = config_object.temp_path
java_cmd = config_object.java.java_cmd
mvn_cmd = config_object.java.mvn_cmd



# Basic input simulation files related file paths

original_simulation_files_paths = [os.path.join(config_object.general_inputs_config.input_path, f) for f in os.listdir(config_object.general_inputs_config.input_path)]

prefix = config_object.general_inputs_config.input_prefix
# The locations of the files that input files after they will be copied
simulation_inputs_location = config_object.global_simulation_inputs_location
simulation_files_paths = [os.path.join(simulation_inputs_location, f) for f in os.listdir(config_object.general_inputs_config.input_path)]
# The name of the base config file (in the original location as well as in the copied one)
input_config_file_name = "%sconfig.xml" % prefix
input_config_path = os.path.join(simulation_inputs_location, input_config_file_name)

rule copy_sim_files:
    input:
        original_simulation_files_paths
    output:
        simulation_files_paths
    threads: 1
    resources:
        mem_mb=2048
    shell:
        """
        cp {config_object.general_inputs_config.input_path}/* {simulation_inputs_location}
        """

# Maven and Java related variables
mvn_project_base_path = to_absolute("../../../../", workflow.basedir)
pom_path = os.path.join(mvn_project_base_path, "pom.xml")
java_sources_base_path = to_absolute("../java", workflow.basedir)
java_sources_paths = [to_absolute(f, workflow.basedir) for f in glob.iglob(java_sources_base_path + "**/**", recursive=True) if os.path.isfile(f)]

jar_path = os.path.join(mvn_project_base_path, "dourdan_feeder_drt_2024", "target", "dourdan_feeder_drt_2024-1.0-SNAPSHOT.jar")

# This rule is meant to compile the ile_de_france package in eqasim-java into a Jar with all the dependencies
rule compile:
    input:
        java_sources_paths,
        pom_path
    output:
        jar_path
    threads: 4
    resources:
        mem_mb=2048
    shell:
        '{mvn_cmd} package -Pstandalone --also-make --file "{pom_path}" -Dmaven.repo.local="{config_object.java.mvn_local_repo}"'

rule baseline_config:
    input:
        jar_path,
        config_object.global_simulation_input_file_path("config.xml")
    output:
        config_object.global_baseline_config_path
    threads: 1
    resources:
        mem_mb=2048
    shell:
        """
        {java_cmd} -cp "{input[0]}" org.eqasim.core.simulation.mode_choice.epsilon.AdaptConfigForEpsilon \
        --input-config-path="{input[1]}" --output-config-path="{output[0]}"
        {java_cmd} -cp "{input[0]}" org.eqasim.core.simulation.vdf.utils.AdaptConfigForVDF \
        --input-config-path="{output[0]}" \
        --output-config-path="{output[0]}" --engine=true \
        --config:eqasim:vdf_engine.generateNetworkEvents=true --config:eqasim:vdf.writeFlowInterval=10 \
        --config:eqasim:vdf.writeInterval=10 --config:controller.lastIteration=100 \
        --config:global.numberOfThreads={config_object.global_simulation_resources.threads}
        """

baseline_trips_path = config_object.global_simulation_output_file_path("eqasim_trips.csv")
baseline_plans_path = config_object.global_simulation_output_file_path("output_plans.xml.gz")
baseline_events_path = config_object.global_simulation_output_file_path("output_events.xml.gz")
baseline_travel_times_path = config_object.global_simulation_output_file_path("vdf_travel_times.bin")

rule global_simulation_baseline:
    input:
        config_object.global_baseline_config_path
    output:
        baseline_trips_path,
        baseline_plans_path,
        baseline_events_path,
        baseline_travel_times_path
    threads: config_object.global_simulation_resources.threads
    resources:
        mem_mb=memory_string_to_mb(config_object.global_simulation_resources.memory)
    shell:
        '''
        {java_cmd} -cp "{jar_path}" -Xmx{config_object.global_simulation_resources.memory} -XX:MaxRAMPercentage=100.0 \
        org.eqasim.ile_de_france.RunSimulation --config-path="{input[0]}" \
        --config:controller.outputDirectory={config_object.global_simulation_outputs_location}
        '''



cut_config_path = config_object.area_baseline_config_path
cut_network_path = config_object.area_simulation_input_file_path("network.xml.gz")

rule cutter:
    input:
        jar_path,
        config_object.global_baseline_config_path,
        baseline_plans_path,
        baseline_events_path,
        baseline_travel_times_path,
        config_object.general_inputs_config.area_path
    output:
        cut_config_path,
        cut_network_path
    threads: config_object.global_simulation_resources.threads
    resources:
        mem_mb=memory_string_to_mb(config_object.global_simulation_resources.memory)
    shell:
        """
        {java_cmd} -cp "{input[0]}" -Xmx{config_object.global_simulation_resources.memory} -XX:MaxRAMPercentage=100.0 org.eqasim.core.scenario.cutter.RunScenarioCutterV2 \
        --config-path={input[1]} --plans-path={input[2]} \
         --events-path={input[3]} \
         --vdf-travel-times-path={input[4]} \
         --extent-path={config_object.general_inputs_config.area_path} \
         --prefix={config_object.general_inputs_config.input_prefix} \
         --flag-area-link-modes=true  \
         --threads={config_object.global_simulation_resources.threads} \
         --output-path={config_object.area_simulation_inputs_location}
        """


rule area_simulation_baseline:
    input:
        jar_path,
        cut_config_path,
    output:
        config_object.area_baseline_simulation_output_file_path("eqasim_trips.csv")
    threads: config_object.area_simulation_resources.threads
    resources:
        mem_mb=memory_string_to_mb(config_object.area_simulation_resources.memory)
    shell:
        '''
        {java_cmd} -cp {jar_path} org.eqasim.core.ile_de_france.RunSimulation -Xmx{config_object.area_simulation_resources.memory} -XX:MaxRAMPercentage=100.0 \
        --config-path{cut_config_path} \
        --config:global.numberOfThreads={config_object.area_simulation_resources.threads} \
        --config:controller.outputDirectory={config_object.area_baseline_simulation_outputs_location}
        '''

rule drt_vehicles:
    input:
        jar_path,
        cut_network_path
    output:
        "%s/{fleetSize}_4.xml" % config_object.area_vehicles_files_location
    shell:
        '''
        mkdir -p {drt_vehicles_location}
        {java_cmd} -cp {jar_path} org.eqasim.core.simulation.modes.drt.utils.CreateDrtVehicles \
        --network-path={cut_network_path} \
        --vehicles-number={wildcards.fleetSize} \
        --network-modes=inside_car \
        --output-vehicles-path={drt_vehicles_location}/drt_vehicles_{wildcards.fleetSize}.xml
        '''


rule all:
    default_target: True
    input:
        baseline_trips_path,
        config_object.area_baseline_simulation_output_file_path("eqasim_trips.csv"),