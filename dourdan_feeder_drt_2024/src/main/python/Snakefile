rule demand_identification_simulation:
    input:
        unpack(lambda wildcards: config_object.get_simulation_inputs(wildcards.hash, demand_identification=True, jar_path=jar_path))
    output:
        ["%s/simulations/demand_identification/{group}/{hash}/%s" % (config_object.output_path, sim_output) for sim_output in PipelineConfig.RELEVANT_SIMULATION_OUTPUTS]
    threads: config_object.area_simulation_resources.threads
    resources:
        mem_mb=memory_string_to_mb(config_object.area_simulation_resources.memory)
    params:
        output_dir=lambda wildcards: "%s/simulations/demand_identification/%s/%s" % (config_object.output_path, wildcards.group, wildcards.hash),
        args=lambda wildcards: config_object.get_simulation_args(wildcards.hash)
    shell:
        """
        {java_cmd} -XX:MaxRAMPercentage=100.0 -Xmx{config_object.area_simulation_resources.memory} -cp {input.jar_path} \
        org.eqasim.papers.dourdan_feeder_drt_2024.RunSimulation --config-path {input.config} \
        --config:multiModeDrt.drt[mode=drt].vehiclesFile {input.vehicles} \
        --config:plans.inputPlansFile {input.plans} \
        --config:controller.outputDirectory {params.output_dir} \
        --config:eqasim.costParametersPath {input.cost_params} {params.args}
        """


rule evaluation_simulation:
    input:
        unpack(lambda wildcards: config_object.get_simulation_inputs(wildcards.hash, demand_identification=False, jar_path=jar_path))
    output:
        ["%s/simulations/evaluation/{group}/{hash}/%s" % (config_object.output_path, sim_output) for sim_output in PipelineConfig.RELEVANT_SIMULATION_OUTPUTS]
    params:
        output_dir=lambda wildcards: "%s/simulations/evaluation/%s/%s" % (config_object.output_path, wildcards.group, wildcards.hash),
        args=lambda wildcards: config_object.get_simulation_args(wildcards.hash)
    shell:
        """
        {java_cmd} -XX:MaxRAMPercentage=100.0 -Xmx{config_object.area_simulation_resources.memory} -cp {input.jar_path} \
        org.eqasim.papers.dourdan_feeder_drt_2024.RunSimulation --config-path {input.config} \
        --config:multiModeDrt.drt[mode=drt] {input.vehicles} \
        --config:plans.inputPlansFile {input.plans} \
        --config:controller.outputDirectory {params.output_dir} \
        --config:eqasim.costParametersPath {input.cost_params} {params.args}
        """


rule all:
    default_target: True
    input:
        baseline_trips_path,
        config_object.area_baseline_simulation_output_file_path("eqasim_trips.csv"),
        [config_object.get_modified_transit_schedule_path(modified_transit_schedule) for modified_transit_schedule in config_object.modified_transit_schedules.values()],
        [config_object.get_deployment_scenario_config_path(deployment_scenario) for deployment_scenario in config_object.deployment_scenarios.values()],
        ["%s/simulations/evaluation/%s/%s/output_plans.xml.gz" % (config_object.output_path, simulation_config.deployment_scenario.name, simulation_config.hash_code) for simulation_config in config_object.simulation_configs.values()]