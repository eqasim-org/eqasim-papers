rule drt_vehicles:
    input:
        jar_path,
        cut_network_path
    output:
        "%s/{fleetSize}_{vehicleCapacity}.xml" % config_object.area_vehicles_files_location
    shell:
        '''
        {java_cmd} -cp {input[0]} org.eqasim.core.simulation.modes.drt.utils.CreateDrtVehicles \
        --network-path={input[1]} \
        --vehicles-number={wildcards.fleetSize} \
        --vehicles-capacity={wildcards.vehicleCapacity} \
        --network-modes=inside_car \
        --output-vehicles-path={output[0]}
        '''

rule cost_params:
    params:
        cost_params=lambda wildcards: config_object.get_cost_params(wildcards.deployment_scenario, wildcards.price)
    output:
        "%s/cost_parameters/{deployment_scenario}/{price}.yaml" % config_object.area_simulation_inputs_location
    run:
        import yaml
        with open(output[0], "w") as f:
            yaml.dump(params.cost_params, f, default_flow_style=False)


rule network_gpkg:
    input:
        jar_path=jar_path,
        schedule_path=config_object.area_simulation_input_file_path("transit_schedule.xml.gz"),
        network_path=config_object.area_simulation_input_file_path("network.xml.gz")
    params:
        crs="EPSG:2154"
    output:
        "%s/misc/network.gpkg" % config_object.output_path
    threads: 1
    resources:
        mem_mb=2048
    shell:
        """
        {java_cmd} -Xmx2G -cp {input.jar_path} org.eqasim.core.tools.ExportTransitLinesToGeopackage \
        --schedule-path {input.schedule_path} --network-path {input.network_path} \
        --crs {params.crs} --output-path={output[0]}
        """

rule modified_transit_schedule_lines:
    input:
        schedule_gpkg="%s/misc/network.gpkg" % config_object.output_path,
        legs=config_object.area_baseline_simulation_output_file_path("eqasim_legs.csv"),
        pt_legs=config_object.area_baseline_simulation_output_file_path("eqasim_pt.csv"),
        area=config_object.general_inputs_config.area_path
    params:
        lambda wildcards: config_object.get_modified_transit_schedule_params(wildcards.schedule)
    threads: 1
    resources:
        mem_mb=4096
    output:
        "%s/modified_transit_schedules/{schedule}/lines_to_remove.csv" % config_object.output_path
    notebook:
        "notebooks/get_unused_buses.ipynb"

rule modified_transit_schedule:
    input:
        jar = jar_path,
        lines = "%s/modified_transit_schedules/{schedule}/lines_to_remove.csv" % config_object.output_path,
        schedule = config_object.area_simulation_input_file_path("transit_schedule.xml.gz")
    threads: 1
    resources:
        mem_mb=2048
    output:
        "%s/modified_transit_schedules/{schedule}/transit_schedule.xml.gz" % config_object.output_path
    shell:
        """
        {java_cmd} -Xmx2G -cp {input.jar}  org.eqasim.papers.dourdan_feeder_drt_2024.RemoveTransitLines \
        --schedule-path {input.schedule} --lines-path {input.lines} \
        --output-path {output[0]}
        """

