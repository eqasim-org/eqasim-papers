def get_rejection_rate(sim_path):
    import pandas as pd
    import os
    import zipfile
    if os.path.isfile(sim_path) and sim_path.endswith(".zip"):
        with zipfile.ZipFile(sim_path) as zip:
            with zip.open("drt_customer_stats_drt.csv") as f:
                df = pd.read_csv(f, sep=";")
    else:
        df = pd.read_csv("%s/drt_customer_stats_drt.csv" % sim_path, sep=";")
    requests = df.iloc[-1]["rides"] + df.iloc[-1]["rejections"]
    rejection_rate = df.iloc[-1]["rejections"] / requests
    return rejection_rate

checkpoint fleet_size_evaluation:
    input:
        ["%s/simulations/fleet_sizing/{area_id}/{group}/{hash}/{fleet_size}/seeds/%d.zip" % (config_object.output_path, seed) for seed in config_object.fleet_sizing_config.fleet_seeds]
    output:
        "%s/simulations/fleet_sizing/{area_id}/{group}/{hash}/{fleet_size}/best.zip" % config_object.output_path
    resources:
        mem_mb=2048,
        runtime=60
    threads: 1
    run:
        import shutil
        # We select the seed with minimum rejection rate
        zips = list(input)
        selected_zip = None
        min_rejection_rate = None
        for zip in zips:
            current_rejection_rate = get_rejection_rate(zip)
            if min_rejection_rate is None or current_rejection_rate < min_rejection_rate:
                min_rejection_rate = current_rejection_rate
                selected_zip = zip
        if min_rejection_rate is None:
            raise Exception("No input!")
        shutil.copy(selected_zip, output[0])



def fleet_sizing_input(wildcards):
    left = int(config_object.fleet_sizing_config.fleet_size_precision)
    left_checkpoint = checkpoints.fleet_size_evaluation.get(area_id=wildcards.area_id, group=wildcards.group, hash=wildcards.hash, fleet_size=left)
    left_rejection_rate = get_rejection_rate(left_checkpoint.output[0])

    if left_rejection_rate <= float(config_object.fleet_sizing_config.max_rejection_rate):
        return left_checkpoint.output[0]
    right = left * 10
    while True:
        right_checkpoint = checkpoints.fleet_size_evaluation.get(area_id=wildcards.area_id, group=wildcards.group, hash=wildcards.hash, fleet_size=right)
        right_value = get_rejection_rate(right_checkpoint.output[0])
        if right_value > float(config_object.fleet_sizing_config.max_rejection_rate):
            left = right
            right *= 2
        else:
            break
        if config_object.fleet_sizing_config.max_fleet_size is not None and config_object.fleet_sizing_config.max_fleet_size < right:
            return right_checkpoint.output[0]

    while right - left > int(config_object.fleet_sizing_config.fleet_size_precision):
        middle = int( (right + left) / 2)
        middle_checkpoint = checkpoints.fleet_size_evaluation.get(area_id=wildcards.area_id, group=wildcards.group, hash=wildcards.hash, fleet_size=middle)
        middle_value = get_rejection_rate(middle_checkpoint.output[0])
        if middle_value < float(config_object.fleet_sizing_config.max_rejection_rate):
            right = middle
            right_checkpoint = middle_checkpoint
        else:
            left = middle
    return right_checkpoint.output[0]


rule fleet_sizing:
    input:
        fleet_sizing_input
    threads: 1
    resources:
        mem_mb=2048,
        runtime=60
    params:
        fleet_size=lambda wildcards, input: str(input[0].split("/")[-2])
    output:
        "%s/simulations/evaluation/{area_id}/{group}/{hash}/results.zip" % config_object.output_path
    run:
        import shutil
        import os
        import zipfile
        shutil.copy(input[0], output[0])
        check = int(params.fleet_size)
        with zipfile.ZipFile(output[0], "a") as zip:
            zip.writestr("fleet_size.txt", params.fleet_size)


rule simulation_summary:
    input:
        "%s/simulations/evaluation/{area_id}/{group}/{hash}/results.zip" % config_object.output_path
    output:
        "%s/simulations/evaluation/{area_id}/{group}/{hash}/summary.yaml" % config_object.output_path
    params:
        summary=lambda wildcards: config_object.hash_to_config(wildcards.hash).get_dict()
    threads: 1
    resources:
        mem_mb=1024,
        runtime=5
    run:
        import yaml
        import os
        import zipfile
        with zipfile.ZipFile(input[0]) as zip:
            with zip.open("fleet_size.txt") as f:
                fleet_size = int(f.read())
        params.summary["fleet_size"] = fleet_size
        with open(output[0], "w") as f:
            yaml.dump(params.summary,  f, default_flow_style=False)


rule all:
    default_target: True
    input:
        expand(["%s/simulations/evaluation/{area_id}/%s/%s/{file}" % (config_object.output_path, simulation_config.deployment_scenario.name, simulation_config.hash_code) for simulation_config in config_object.simulation_configs.values()],
            area_id=list(config_object.area_configs.keys()),
            file=["results.zip", "summary.yaml"]),