rule area_buffer:
    input:
        lambda wildcards: config_object.get_area_by_prefix(wildcards.area_prefix).path
    output:
        "%s/misc/{area_prefix}area_buffer.gpkg" % config_object.output_path
    params:
        buffer_length=lambda wildcards: config_object.get_area_by_prefix(wildcards.area_prefix).buffer_length,
        runtime=5
    run:
        import geopandas as gpd
        gdf = gpd.read_file(input[0])
        gdf = gpd.GeoDataFrame(geometry=gdf.buffer(params.buffer_length), crs=gdf.crs)
        gdf.to_file(output[0])

