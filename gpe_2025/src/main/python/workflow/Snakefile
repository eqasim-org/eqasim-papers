def get_non_feeder_related_outputs(output_type, scenarios=None):
    if scenarios is None:
        scenarios  = [s for s in  config_object.scenarios.values() if s.feeders is None]
    else:
        if not isinstance(scenarios, list):
            scenarios = [scenarios]
        for s in scenarios:
            if s.feeders is not None:
                raise Exception("Scenario %s has feeder services configured" % s.scenario_name)
    if output_type == "mode_choice":
        l = ["%s/mode_choice/outputs_simulated/%s" % (config_object.output_path, s.scenario_name) for s in scenarios]
    elif output_type == "routing":
        l = ["%s/routing/outputs/simulated_%s_pt" % (config_object.output_path, s.scenario_name) for s in scenarios]
    elif output_type == "simulation":
        l = ["%s/simulations/outputs/%s" % (config_object.output_path, s.scenario_name) for s in scenarios]
    else:
        raise Exception("Unsupported output type %s" % output_type)
    return l


'''
The method below retrieves the routing or mode choice outputs for one or more feeder scenarios
@:param output_type: either 'routing' or 'mode_choice' depending on the output desired
@:param scenarios: The scenarios for which the outputs are desired. If None, will retrieve the outputs of all feeder scenarios
@:param radiis: if not None, specifies a set of radius values for which the outputs are desired (has to be a subset of the values specified in the scenario)
@:param frequencies: if not None, specifies a set of frequency values for which the outputs are desired (has to be a subset of the values specified in the scenario)
@:param speeds: if not None, specifies a set of speed values for which the outputs are desired (has to be a subset of the values specified in the scenario)
'''
def get_feeder_related_outputs(output_type, scenarios=None, radiis=None, frequencies=None, speeds=None):
    if scenarios is None:
        scenarios = [s for s in  config_object.scenarios.values() if s.feeders is not None]
    else :
        if not isinstance(scenarios, list):
            scenarios = [scenarios]
        for s in scenarios:
            if s.feeders is None:
                raise Exception("Scenario %s has no feeder services configured" % s.scenario_name)

    if radiis is not None and not isinstance(radiis, list):
        radiis = [radiis]
    if frequencies is not None and not isinstance(frequencies, list):
        frequencies = [frequencies]
    if speeds is not None and not isinstance(speeds, list):
        speeds = [speeds]
    if output_type == "routing":
        base_path = "%s/routing/outputs/simulated_%s_transitWithAbstractAccess_{radius}_{frequency}_{speed_index}"
    elif output_type == "mode_choice":
        base_path = "%s/mode_choice/outputs_simulated/%s_{radius}_{frequency}_{speed_index}"
    elif output_type == "simulation":
        base_path = "%s/simulations/outputs/%s_{radius}_{frequency}_{speed_index}"
    else:
        raise Exception("Unkown output_type %s" % output_type)

    l = [expand(base_path % (config_object.output_path, s.scenario_name),
        radius=[radius for radius in s.feeders.radiis if radius in (radiis if radiis is not None else s.feeders.radiis)],
        frequency=[frequency for frequency in s.feeders.frequencies if frequency in (frequencies if frequencies is not None else s.feeders.frequencies)],
        speed_index=[i for i in range(len(s.feeders.speeds)) if s.feeders.speeds[i] in (speeds if speeds is not None else s.feeders.speeds)])  for s in scenarios]

    l = flatten(l)
    if len(l) == 1:
        l = l[0]
    return l


# This rule performs the sensitivity analysis for feeder services on a single scenario based on routing results
rule routing_feeder_analysis:
    input:
        feeder_outputs=lambda wildcards: get_feeder_related_outputs("routing", config_object.scenarios[wildcards.scenario]),
        no_feeder_outputs= lambda wildcards: get_non_feeder_related_outputs("routing", config_object.scenarios[config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart]) if config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart is not None else []
    params:
        config = config,
        pipeline_kwargs = dict(basedir=workflow.basedir, max_cores=workflow.cores),
        # Multiple Named input parameters that are lists get converted into one list losing the names
        # So I have to put them again as parameters here
        feeder_outputs = lambda wildcards: get_feeder_related_outputs("routing", config_object.scenarios[wildcards.scenario]),
        no_feeder_outputs = lambda wildcards: get_non_feeder_related_outputs("routing", config_object.scenarios[config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart]) if config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart is not None else []
    output:
        "%s/routing/feeder_analyses/{scenario}.ipynb" % config_object.output_path
    threads: 1
    resources:
        mem_mb=analysis_memory_mb
    log:
        notebook="%s/routing/feeder_analyses/{scenario}.ipynb" % config_object.output_path
    notebook:
        "../notebooks/routing_feeder_analysis.ipynb"

