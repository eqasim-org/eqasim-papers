# This method is in charge of retrieving the inputs required for running analyses
# These inputs are the outputs of running a routing or a mode choice
def get_analysis_inputs(analysis):
    outputs = {label: ("%s/routing/outputs/simulated_%s_pt" if analysis.type == "routing" else "%s/mode_choice/outputs_simulated/%s") % (config_object.output_path, item[0].scenario_name) for label, item in analysis.scenario_items.items() if item[2] is None}
    outputs.update({label: get_feeder_related_outputs(analysis.type, scenarios=item[0], radiis=item[2]["radius"], frequencies=item[2]["frequency"], speeds=item[2]["speed"]) for label, item in analysis.scenario_items.items() if item[2] is not None})
    return outputs

# Here we programmatically create the rules in charge of performing the analyses specified in the config file
# These analyses simply compare between multiple scenario outputs (either from routing or mode choice)
for analysis in config_object.analyses.values():
    rule:
        name: "analysis_%s" % analysis.analysis_name
        input:
            **get_analysis_inputs(analysis) # For some reason snakemake converts this into a list so I have to also pass it as a parameter to have the labels too
        params:
            config = config,
            pipeline_kwargs = dict(basedir=workflow.basedir, max_cores=workflow.cores),
            analysis_name = analysis.analysis_name,
            scenarios = dict(**get_analysis_inputs(analysis)),
            reference = analysis.reference
        threads: 1
        resources:
            mem_mb=analysis_memory_mb
        output:
            "%s/%s/scenario_comparisons/%s.ipynb" % (config_object.output_path, analysis.type, analysis.analysis_name)
        log:
            notebook="%s/%s/scenario_comparisons/%s.ipynb" % (config_object.output_path, analysis.type, analysis.analysis_name)
        notebook: "../notebooks/%s_scenario_analysis.ipynb" % analysis.type


def get_all_outputs():
    outputs = set()

    # We check if all non feeder scenarios are to be considered
    if config_object.run_non_feeders != "requiredOnly":
        if config_object.run_non_feeders != "all":
            methods = [config_object.run_non_feeders]
        else:
            methods = ["mode_choice", "routing"]
        for method in methods:
            outputs = outputs.union(get_non_feeder_related_outputs(method))

    # Next we check feeder scenarios
    if config_object.run_feeders != "requiredOnly":
        scenarios = [s for s in config_object.scenarios.values() if s.feeders is not None]
        if config_object.run_feeders in ["all", "mode_choice"]:
            outputs = outputs.union(["%s/mode_choice/feeder_analyses/%s.ipynb" % (config_object.output_path, s.scenario_name) for s in scenarios])
        if config_object.run_feeders in ["all", "routing"]:
            outputs = outputs.union(["%s/routing/feeder_analyses/%s.ipynb" % (config_object.output_path, s.scenario_name) for s in scenarios])

    # outputs = outputs.union(get_non_feeder_related_outputs("simulation"))
    # outputs = outputs.union(get_feeder_related_outputs("simulation"))

    # Now we check the analyses
    for analysis in config_object.analyses.values():
        outputs.add("%s/%s/scenario_comparisons/%s.ipynb" % (config_object.output_path, analysis.type, analysis.analysis_name))

    return outputs

rule all:
    default_target: True
    input:
        get_all_outputs()