    output:
        output_path=directory("%s/routing/outputs/simulated_{scenario}_{mode}_{radius}_{frequency}_{speed_index}" % config_object.output_path)


rule mode_choice:
    input:
        jar=jar_path,
        config=""
    params:
        extra_args="",
        memory_str=config_object.resources.memory,
        java_cmd=java_cmd
    threads:
        config_object.resources.max_threads
    resources:
        mem_mb=memory_mb + java_memory_offset
    output:
        output_path=""
    shell:
        '''
        {params.java_cmd} -Xmx{params.memory_str} -XX:MaxRAMPercentage=100.0 -cp {input.jar} org.eqasim.core.standalone_mode_choice.RunStandaloneModeChoice \
        --config-path={input.config} --config:standaloneModeChoice.outputDirectory={output.output_path} \
        --config:standaloneModeChoice.removePersonsWithNoValidAlternatives=true --config:global.numberOfThreads={threads} {params.extra_args}
        '''

use rule mode_choice as regular_mode_choice with:
    input:
        jar=jar_path,
        config=lambda wildcards: get_simulation_input_file("config.xml", wildcards.scenario)
    output:
        output_path=directory("%s/mode_choice/outputs/{scenario}" % config_object.output_path)

use rule mode_choice as feeder_mode_choice with:
    input:
        jar=jar_path,
        config="%s/cache/inputs/{scenario}/config_abstract_access_{radius}_{frequency}_{speed_index}.xml" % config_object.output_path
    output:
        output_path=directory("%s/mode_choice/outputs/{scenario}_{radius}_{frequency}_{speed_index}" % config_object.output_path)

use rule simulation as post_mode_choice_simulation with:
    input:
        jar=jar_path,
        config=lambda wildcards: get_simulation_input_file("config.xml", wildcards.scenario),
        mode_choice_outputs="%s/mode_choice/outputs/{scenario}{remaining}" % config_object.output_path
    output:
        output_path=directory("%s/mode_choice/outputs_simulated/{scenario}{remaining}" % config_object.output_path)
    params:
        extra_args = lambda wildcards, input: "--config:controller.lastIteration=0 --config:swissRailRaptor.transferCalculation=Adaptive --config:plans.inputPlansFile=%s/output_plans.xml.gz" % input.mode_choice_outputs

# Creates abstract accesses items files
rule create_abstract_accesses:
    params:
        radius=lambda wildcards: wildcards.radius,
        speed=lambda wildcards: config_object.scenarios[wildcards.scenario].feeders.speeds[int(wildcards.speed_index)],
        using_routed_distance=False,
        access_type="bus",
        frequency=lambda wildcards: wildcards.frequency
    resources:
        mem_mb=512
    output:
        "%s/abstract_accesses/items/{scenario}/{radius}_{frequency}_{speed_index}.xml" % config_object.output_path
    threads: 1
    script:
        "../scripts/create_abstract_accesses.py"

# Create config files
rule adapt_config:
    input:
        config=lambda wildcards: get_simulation_input_file("config.xml", wildcards.scenario),
        abstract_access_items="%s/abstract_accesses/items/{scenario}/{radius}_{frequency}_{speed_index}.xml" % config_object.output_path,
        jar=jar_path
    output:
        "%s/cache/inputs/{scenario}/config_abstract_access_{radius}_{frequency}_{speed_index}.xml" % config_object.output_path
    params:
        java_cmd=java_cmd,
    shell:
        '''
        {params.java_cmd} -cp {input.jar} org.eqasim.core.simulation.modes.transit_with_abstract_access.utils.AdaptConfigForTransitWithAbstractAccess \
        --accesses-file-path={input.abstract_access_items} \
        --mode-name=transitWithAbstractAccess --input-config-path={input.config} --output-config-path={output[0]}
        '''


def get_feeder_routed_outputs(scenarios=None):
    if scenarios is None:
        scenarios = [s for s in  config_object.scenarios.values() if s.feeders is not None]
    l = [expand("%s/routing/outputs/simulated_%s_transitWithAbstractAccess_{radius}_{frequency}_{speed_index}" % (config_object.output_path, s.scenario_name),
        radius=s.feeders.radiis,
        frequency=s.feeders.frequencies,
        speed_index=list(range(len(s.feeders.speeds))))  for s in scenarios]
    return flatten(l)

def get_feeder_mode_choice_outputs(scenarios=None):
    if scenarios is None:
        scenarios = [s for s in  config_object.scenarios.values() if s.feeders is not None]
    l = [expand("%s/mode_choice/outputs_simulated/%s_{radius}_{frequency}_{speed_index}" % (config_object.output_path, s.scenario_name),
        radius=s.feeders.radiis,
        frequency=s.feeders.frequencies,
        speed_index=list(range(len(s.feeders.speeds))))  for s in scenarios]
    return flatten(l)

rule routing_feeder_analysis:
    input:
        feeder_outputs=lambda wildcards: get_feeder_routed_outputs([config_object.scenarios[wildcards.scenario]]),
        no_feeder_outputs=lambda wildcards: "%s/routing/outputs/simulated_%s_pt" % (config_object.output_path, config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart) if config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart is not None else []
    params:
        config = config,
        pipeline_kwargs = dict(basedir=workflow.basedir, max_cores=workflow.cores),
        # Multiple Named input parameters that are lists get converted into one list losing the names
        # So I have to put them again as parameters here
        feeder_outputs = lambda wildcards: get_feeder_routed_outputs([config_object.scenarios[wildcards.scenario]]),
        no_feeder_outputs = lambda wildcards: "%s/routing/outputs/simulated_%s_pt" % (config_object.output_path, config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart) if config_object.scenarios[wildcards.scenario].feeders.no_feeder_counterpart is not None else None
    output:
        "%s/routing/feeder_analyses/{scenario}.ipynb" % config_object.output_path
    log:
        notebook="%s/routing/feeder_analyses/{scenario}.ipynb" % config_object.output_path
    notebook:
        "../notebooks/routing_feeder_analysis.ipynb"

rule all:
    default_target: True
    input:
        get_feeder_routed_outputs(),
        get_feeder_mode_choice_outputs(),
        [["%s/routing/outputs/simulated_%s_pt" % (config_object.output_path, s.scenario_name),
          "%s/mode_choice/outputs_simulated/%s" % (config_object.output_path, s.scenario_name)] for s in config_object.scenarios.values() if s.feeders is not None],
        ["%s/routing/feeder_analyses/%s.ipynb" % (config_object.output_path, s.scenario_name) for s in config_object.scenarios.values() if s.feeders is not None]