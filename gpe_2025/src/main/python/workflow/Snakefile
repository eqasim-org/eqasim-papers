def recursive_update(destination, source):
    for k, v in source.items():
        if k not in destination:
            destination[k] = v
        elif isinstance(v, collections.abc.Mapping):
            destination[k] = recursive_update(destination.get(k, {}), v)
    return destination

def repo_url_to_id(repo_url):
    # SSH link example "git@github.com:eqasim-org/ile-de-france.git"
    # HTTPS link example https://github.com/eqasim-org/ile-de-france.git
    assert isinstance(repo_url,str)
    if not repo_url.startswith("git@github.com") and not repo_url.startswith("https://github.com"):
        raise Exception("Invalid repo_url")
    components = repo_url.split("/")
    repo_owner, repo_name = components[-2], components[-1]
    repo_name = repo_name.replace(".git","")
    repo_owner = repo_owner.split(":")[-1]
    return "%s/%s" % (repo_owner, repo_name)


default_config = {"java": {"java_cmd": "java", "mvn_cmd": "mvn"},
                  "resources": {"max-threads": 12, "memory": "50G"},
                  "output_path": to_absolute("outputs", workflow.basedir)}

recursive_update(config, default_config)
config_object = PipelineConfig(config, workflow.basedir, workflow.cores)

# Maven and Java related variables
mvn_project_base_path = to_absolute("../../../../", workflow.basedir)
pom_path = os.path.join(mvn_project_base_path, "pom.xml")
mvn_repository_path = to_absolute(".m2", workflow.basedir)
java_sources_base_path = to_absolute("../java", workflow.basedir)
java_sources_paths = [to_absolute(f, workflow.basedir) for f in
                      glob.iglob(java_sources_base_path + "**/**",recursive=True) if os.path.isfile(f)]

jar_path = to_absolute(os.path.join("../../../../","target","gpe_2025-1.0-SNAPSHOT.jar"), workflow.basedir)


mvn_cmd = config["java"]["mvn_cmd"]
java_cmd = config["java"]["java_cmd"]


memory_str = config["resources"]["memory"]

def memory_string_to_mb(memory_string):
    assert isinstance(memory_string, str)
    assert memory_string.endswith("G")
    return int(memory_string[0:len(memory_string)-1]) * 1024

memory_mb = memory_string_to_mb(config["resources"]["memory"])

java_memory_offset = 10240

def get_simulation_input_file(input_file, scenario, **kwargs):
    return os.path.join(config_object.output_path, "cache/inputs/%s" % scenario, config_object.scenarios[scenario].prefix + input_file)


wildcard_constraints:
    scenario="[a-zA-Z]+",
    mode="[a-zA-Z]+",
    remaining="(_.+){0,1}"

# We need to create the input copying rules in a procedural way because we need the scenario prefix in the output path
for scenario in config_object.scenarios.values():
    rule:
        name:
            f"copy_{scenario.scenario_name}_inputs"
        input:
            scenario.path
        output:
            # We mention as outputs of this rules the files that are explicitly referenced by other rules
            # But still we copy all the directory content
            "%s/cache/inputs/%s/%sconfig.xml" % (config_object.output_path, scenario.scenario_name, scenario.prefix),
            "%s/cache/inputs/%s/%spopulation.xml.gz" % (config_object.output_path, scenario.scenario_name, scenario.prefix)
        params:
            outputs_location = lambda wildcards, output: os.path.dirname(output[0])
        shell:
            '''
            pwd
            echo "Creating folder {params.outputs_location}"
            mkdir -p {params.outputs_location}
            echo "Copying files into {params.outputs_location}"
            cp {input[0]}/* {params.outputs_location}/
            '''

# This rule compiles the current maven module into a standalone jar
rule compile:
    input:
        java_sources_paths,
        pom_path
    output:
        jar_path
    params:
        mvn_cmd=config_object.java.mvn_cmd
    threads: 4
    resources:
        mem_mb=4096
    shell:
        '{params.mvn_cmd} package -Pstandalone --also-make --file "{pom_path}" -Dmaven.repo.local="{mvn_repository_path}"'


# The following rules are related to the evaluation of quality of PT trips between the control and the GPE scenarios
# First, this rule processes the population so that each agent has only one trip and all trips are set to a certain mode
rule one_agent_per_trip:
    input:
        jar=jar_path,
        population=lambda wildcards: get_simulation_input_file("population.xml.gz", wildcards.scenario),
    output:
        "%s/routing/inputs/split_population_{scenario}_{mode}.xml.gz" % config_object.output_path
    threads: 4
    resources:
        mem_mb=4096 + java_memory_offset
    params:
        java_cmd=config_object.java.java_cmd
    shell:
        '''
        mkdir -p "$(dirname {output[0]})"
        {params.java_cmd} -Xmx4G -cp {input.jar} org.eqasim.papers.gpe2025.utils.OneAgentPerTrip \
        --input-path={input.population} --override-mode={wildcards.mode} --output-path={output[0]}
        '''

# The rule below performs the population routing.
# The base version of this rule takes the initial configuration of the scenario as well as the split plans
rule run_population_routing:
    input:
        jar=jar_path,
        config=lambda wildcards: get_simulation_input_file("config.xml", wildcards.scenario),
        plans="%s/routing/inputs/split_population_{scenario}_{mode}.xml.gz" % config_object.output_path
    output:
        "%s/routing/outputs/split_population_{scenario}_{mode}.xml.gz" % config_object.output_path
    params:
        memory_str=config_object.resources.memory,
        java_cmd=config_object.java.java_cmd
    threads: config_object.resources.max_threads
    resources:
        mem_mb=memory_mb + java_memory_offset
    shell:
        '''
        mkdir -p "$(dirname {output[0]})"
        {params.java_cmd} -Xmx{params.memory_str} -XX:MaxRAMPercentage=100.0 -cp {input.jar} org.eqasim.core.scenario.routing.RunPopulationRouting \
        --config-path={input.config} --output-path={output[0]} --config:plans.inputPlansFile={input.plans} \
        --threads={threads}
        '''

# The following rule is an override of the previous one focusing on routing trips in a specific feeder setting
use rule run_population_routing as run_population_routing_with_feeders with:
    input:
        jar=jar_path,
        config="%s/cache/inputs/{scenario}/config_abstract_access_{radius}_{frequency}_{speed_index}.xml" % config_object.output_path,
        plans="%s/routing/inputs/split_population_{scenario}_{mode}.xml.gz" % config_object.output_path
    output:
        "%s/routing/outputs/split_population_{scenario}_{mode}_{radius}_{frequency}_{speed_index}.xml.gz" % config_object.output_path

# This rule is a generic one that allows to perform simulations
rule simulation:
    input:
        jar=jar_path,
        config=""
    params:
        extra_args = "",
        memory_str=config_object.resources.memory,
        java_cmd=config_object.java.java_cmd
    threads: min(config_object.resources.max_threads, 12)
    resources:
        mem_mb=memory_mb + java_memory_offset
    output:
        output_path=""
    shell:
        '''
        {params.java_cmd} -Xmx{params.memory_str} -XX:MaxRAMPercentage=100.0 -cp {input.jar} org.eqasim.papers.gpe2025.RunSimulation \
        --config-path={input.config} --config:controller.outputDirectory={output.output_path} \
        --config:global.numberOfThreads={threads} {params.extra_args}
        '''

# This rule performs simulations of split populations that were previously routed
use rule simulation as post_routing_simulation with:
    input:
        jar=jar_path,
        config=lambda wildcards: get_simulation_input_file("config.xml", wildcards.scenario),
        plans="%s/routing/outputs/split_population_{scenario}_{mode}.xml.gz" % config_object.output_path
    params:
        extra_args = lambda wildcards, input: "--config:controller.lastIteration=0 --config:swissRailRaptor.transferCalculation=Adaptive --config:plans.inputPlansFile=%s" % input.plans,
    output:
        output_path=directory("%s/routing/outputs/simulated_{scenario}_{mode}" % config_object.output_path)



use rule post_routing_simulation as post_routing_simulation_with_feeders with:
    input:
        jar=jar_path,
        config="%s/cache/inputs/{scenario}/config_abstract_access_{radius}_{frequency}_{speed_index}.xml" % config_object.output_path,
